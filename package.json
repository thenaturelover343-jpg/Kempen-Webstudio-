{
  "name": "kempen-webstudio",
  "description": "Website van Kempen Webstudio (www.kempenwebstudio.be): statische build in het nieuwe design.",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "import": "node scripts/import-content.mjs",
    "build": "npm run build:test && npm run build:live",
    "build:test": "node scripts/build.mjs --mode test",
    "build:live": "node scripts/build.mjs --mode live",
    "serve": "node scripts/serve.mjs dist-test 4100",
    "serve:live": "node scripts/serve.mjs dist-live 4101",
    "check": "node scripts/check.mjs dist-live && node scripts/check.mjs dist-test",
    "lighthouse": "node scripts/lighthouse.mjs",
    "screens": "node scripts/screens.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter-tight": "^5.2.7",
    "@tailwindcss/cli": "^4.1.17",
    "esbuild": "^0.27.0",
    "linkedom": "^0.18.12",
    "lucide-react": "^0.546.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.5",
    "subset-font": "^2.4.0",
    "tailwindcss": "^4.1.17"
  },
  "optionalDependencies": {
    "lighthouse": "^12.8.2",
    "playwright-core": "^1.56.1"
  }
}
